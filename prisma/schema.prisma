generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MuscleGroup {
  chest
  back
  shoulders
  biceps
  triceps
  forearms
  quadriceps
  hamstrings
  glutes
  calves
  abs
  cardio

  @@map("muscle_group")
}

enum SetType {
  warmup
  failure
  dropset
  normal

  @@map("set_type")
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar()
  email           String           @unique @db.VarChar()
  bodyWeight      Float?           @map("body_weight") @db.Real
  hash            String           @db.VarChar()
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  workouts        Workout[]
  refreshToken    String?          @map("refresh_token") @db.VarChar(512)
  exerciseRecords ExerciseRecord[]
  routines        Routine[]

  @@map("user")
}

model Workout {
  id               String            @id @default(uuid()) @db.Uuid
  title            String            @db.VarChar()
  description      String?           @db.VarChar()
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String            @map("user_id") @db.Uuid
  workoutExercises WorkoutExercise[]

  @@map("workout")
}

model Exercise {
  id               String            @id @default(uuid()) @db.Uuid
  title            String            @unique @db.VarChar()
  muscleGroups     MuscleGroup[]     @map("muscle_groups")
  workoutExercises WorkoutExercise[]
  exerciseRecords  ExerciseRecord[]
  routineExercises RoutineExercise[]

  @@map("exercise")
}

model WorkoutExercise {
  id          String  @id @default(uuid()) @db.Uuid
  description String? @db.VarChar()

  workoutId String  @map("workout_id") @db.Uuid
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  exerciseId String   @map("exercise_id") @db.Uuid
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  order Int   @db.Integer
  sets  Set[]

  @@map("workout_exercise")
}

model Set {
  id String @id @default(uuid()) @db.Uuid

  workoutExerciseId String          @map("workout_exercise_id") @db.Uuid
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  weight            Float?          @default(0) @db.Real
  order             Int             @db.Integer
  reps              Int             @db.Integer
  type              SetType         @default(normal)

  @@map("set")
}

model ExerciseRecord {
  id         String   @id @default(uuid())
  userId     String   @map("user_id") @db.Uuid()
  exerciseId String   @map("exercise_id") @db.Uuid()
  
  maxWeight  Float    @map("max_weight") @db.Real  
  maxReps    Int      @map("max_reps") @db.Integer  

  bestWeight Float    @map("best_weight") @db.Real  
  bestReps   Int      @map("best_reps") @db.Integer 

  maxVolume  Float    @map("max_volume") @db.Real
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@map("exercise_record")
}

model Routine {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String  @db.VarChar()
  description String? @db.VarChar()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  exercises RoutineExercise[]

  @@map("routine")
}

model RoutineExercise {
  id String @id @default(uuid()) @db.Uuid

  routineId String  @map("routine_id") @db.Uuid
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  exerciseId String   @map("exercise_id") @db.Uuid
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  order Int          @db.Integer
  sets  RoutineSet[]

  @@map("routine_exercise")
}

model RoutineSet {
  id String @id @default(uuid()) @db.Uuid

  routineExerciseId String          @map("routine_exercise_id") @db.Uuid
  routineExercise   RoutineExercise @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)

  targetReps   Int     @map("target_reps") @db.Integer
  targetWeight Float?  @map("target_weight") @db.Real
  type         SetType @default(normal)
  order        Int     @db.Integer

  @@map("routine_set")
}
